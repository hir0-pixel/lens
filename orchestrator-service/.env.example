# Lens Orchestrator service. Production values come from workload identity and
# the approved secrets system; do not commit populated runtime files.
HOST=127.0.0.1
PORT=8789

# BFF -> Orchestrator workload credential (development only when static).
LENS_ORCHESTRATOR_WORKLOAD_TOKEN=replace-with-at-least-32-random-characters

# Orchestrator -> Retrieval. Production uses internal DNS, TLS, and mTLS.
LENS_RETRIEVAL_URL=https://retrieval.platform.internal
LENS_RETRIEVAL_WORKLOAD_TOKEN=replace-with-at-least-32-random-characters

# Company-hosted inference control API. It owns global GPU admission,
# scheduling, batching, and scale; the Orchestrator never calls a model vendor.
LENS_MODEL_RUNTIME_URL=https://inference.platform.internal
LENS_MODEL_RUNTIME_WORKLOAD_TOKEN=replace-with-at-least-32-random-characters
LENS_MODEL_ARTIFACT_DIGEST=sha256:replace-with-approved-64-character-artifact-digest
