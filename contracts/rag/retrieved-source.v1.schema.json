{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lens:rag:retrieved-source:v1",
  "title": "Lens retrieved source (v1)",
  "description": "Exact immutable document-version and chunk identity. Citation mapping is 1:1 to these references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_version_ref", "chunk_ref", "content_digest", "citation_anchor", "classification_ref"],
  "properties": {
    "document_version_ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$" },
    "chunk_ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$" },
    "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "citation_anchor": { "type": "string", "maxLength": 256 },
    "classification_ref": { "enum": ["public", "internal", "confidential", "restricted"] }
  }
}