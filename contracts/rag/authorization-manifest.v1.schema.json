{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lens:rag:authorization-manifest:v1",
  "title": "Lens retrieval authorization manifest (v1)",
  "description": "Immutable lineage + PDP decision references. This is evidence of authorized context, never an authorization decision the client can construct.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "digest",
    "retrieved_at",
    "source_revision_digest",
    "operation_decision_ref",
    "candidate_decision_ref",
    "policy_revision",
    "subject_security_revision",
    "resource_security_revision_digest",
    "profile_version",
    "profile_digest",
    "expires_at",
    "sources"
  ],
  "properties": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "retrieved_at": { "type": "integer", "minimum": 1 },
    "source_revision_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "operation_decision_ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
    "candidate_decision_ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
    "policy_revision": { "type": "integer", "minimum": 1 },
    "subject_security_revision": { "type": "integer", "minimum": 1 },
    "resource_security_revision_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "profile_version": { "type": "integer", "minimum": 1 },
    "profile_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "expires_at": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "urn:lens:rag:retrieved-source:v1" }
    }
  }
}