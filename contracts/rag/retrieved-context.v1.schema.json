{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lens:rag:retrieved-context:v1",
  "title": "Lens retrieved authorized context (v1)",
  "description": "Authorized protected chunk text returned only from Retrieval to Orchestrator after live authorization and audit admission. Authorization manifests continue to reference the text-free retrieved-source contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_version_ref", "chunk_ref", "content_digest", "citation_anchor", "classification_ref", "text"],
  "properties": {
    "document_version_ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$" },
    "chunk_ref": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$" },
    "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "citation_anchor": { "type": "string", "maxLength": 256 },
    "classification_ref": { "enum": ["public", "internal", "confidential", "restricted"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 65536 }
  }
}
