# =============================================================================
# Lens BFF environment (server/.env) — dev/test
# =============================================================================
# Copy this file to `server/.env` and fill in your Identity Gateway values.
# NEVER commit real secrets. The corporate values below are provided by your
# identity/infrastructure team.
#
# The BFF is the only place that holds the OIDC client secret; the browser UI
# never sees it. See server/docs/AUTHENTICATION.md.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Vite (this repo) proxies /auth and /api here, so requests look same-origin.
# Origin the browser sees; matches the Vite dev server port.
APP_ORIGIN=http://localhost:1420

# --- Session cookie secret (required) ----------------------------------------
# Generate: openssl rand -base64 48   (must be >= 32 bytes)
SESSION_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef

# --- OIDC (corporate Identity Gateway) — ALL UNINVENTABLE --------------------
# Point these at YOUR IdP. For local dev, run a local OIDC provider
# (e.g. Keycloak on localhost) and set:
#OIDC_ISSUER=https://localhost:8443/realms/lens
#OIDC_CLIENT_ID=lens-bff
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
#OIDC_SCOPES=openid profile email

# --- Test gateway mode (isolated, explicit opt-in) ---------------------------
#OIDC_TEST_MODE=true

# --- Rate limiting -----------------------------------------------------------
#RATE_LIMIT_WINDOW_MS=900000
#RATE_LIMIT_MAX_REQUESTS=100
#AUTH_RATE_LIMIT_MAX_REQUESTS=10