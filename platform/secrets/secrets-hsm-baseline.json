{
  "version": 1,
  "owner": "platform/secrets",
  "contracts": ["WORKLOAD-IDENTITY", "CRYPTOGRAPHIC-PROFILE", "SECURE-SOFTWARE-DELIVERY"],
  "service": {
    "onPremisesOnly": true,
    "publicControlPlane": false,
    "cloudKms": false,
    "hostedCa": false,
    "runtimeInternetDependency": false,
    "metadataStore": { "voters": 5, "placement": "2-2-1-independent-failure-domains", "twoVoterHa": false }
  },
  "hsm": {
    "privateRootsNonExportable": true,
    "wrappingKeysNonExportable": true,
    "signingKeysNonExportable": true,
    "softwareRootFallback": false,
    "separateDrHsmCapacity": true,
    "recovery": "dual-control-encrypted-shares-and-current-revocation-epoch"
  },
  "disasterRecovery": {
    "checkpointMaxSeconds": 60,
    "auditCheckpointCoupled": true,
    "staleOrUnverifiableCheckpoint": "deny-issuance-key-operations-and-protected-admission",
    "normalIssuanceAfterRecovery": "requires-signed-recovery-manifest-current-key-and-revocation-epochs-and-audit-witness"
  },
  "leases": {
    "dynamicOnly": true,
    "maxLeaseSeconds": 3600,
    "expiryBehavior": "deny",
    "revocationBehavior": "deny-immediately",
    "credentialsInImages": false,
    "credentialsInManifests": false,
    "credentialsInGlobalEnvironment": false
  },
  "keyPurposeSeparation": ["identity", "encryption", "wrapping", "signing", "audit", "release", "approval"],
  "sensitiveOperations": {
    "auditAdmissionRequired": true,
    "transactionalOutboxForMetadataMutations": true,
    "privilegedHumanAccess": "jit-proxy-only"
  }
}
