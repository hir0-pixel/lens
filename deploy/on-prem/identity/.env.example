LENS_IDENTITY_DATABASE_NAME=lens_identity
LENS_IDENTITY_DATABASE_USER=lens_identity
LENS_IDENTITY_DATABASE_PASSWORD=replace-with-a-unique-database-password
LENS_IDENTITY_ADMIN_USERNAME=replace-with-an-internal-admin-name
LENS_IDENTITY_ADMIN_PASSWORD=replace-with-a-unique-admin-password
LENS_IDENTITY_BIND_ADDRESS=127.0.0.1
LENS_SESSION_GATEWAY_MODE=internal-test-only
LENS_SESSION_GATEWAY_PORT=8081
LENS_IDENTITY_ISSUER=https://identity.platform.internal:8443/realms/lens-internal
LENS_SESSION_GATEWAY_CLIENT_ID=lens-session-gateway
LENS_SESSION_GATEWAY_CLIENT_SECRET=replace-with-the-keycloak-client-secret
LENS_SESSION_GATEWAY_ALLOWED_ORIGIN=http://localhost:1420
LENS_SESSION_GATEWAY_EDGE_TOKEN=replace-with-a-distinct-session-edge-token
LENS_SESSION_GATEWAY_REDIRECT_URI=https://lens-gateway.platform.internal:8444/auth/callback
LENS_INTERNAL_MODEL_BRIDGE_URL=http://edge:8082/v1/lab/generate
LENS_INTERNAL_MODEL_BRIDGE_TOKEN=replace-with-the-existing-lab-gateway-token
LENS_EDGE_RELAY_TOKEN=replace-with-a-distinct-edge-relay-token
