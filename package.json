{
  "name": "lens-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bootstrap": "node platform/build/workspace.mjs bootstrap",
    "generate": "node platform/build/workspace.mjs generate",
    "contracts:check": "node scripts/contracts/check.mjs",
    "contracts:provenance": "node scripts/contracts/provenance.mjs",
    "dev": "vite",
    "build": "node platform/build/workspace.mjs build",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "npm run generate && vitest run",
    "test-contract": "npm run generate && npm run contracts:check && vitest run tests/contract",
    "test-integration": "npm run generate && vitest run tests/integration/contract-probe.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "npm run generate && tsc --noEmit",
    "verify:m00": "node platform/build/workspace.mjs verify",
    "validate": "node scripts/validate/check.mjs",
    "test:m00-platform": "node platform/build/m00-preflight.mjs",
    "test:m01": "vitest run tests/security tests/integration/m01-workload-trust.test.ts",
    "verify:m01": "npm run generate && npm run typecheck && npm run lint && npm run test:m01",
    "verify": "node platform/build/workspace.mjs verify",
    "release:checklist": "node scripts/release/print-checklist.mjs",
    "changelog:stub": "node scripts/release/changelog-stub.mjs"
  },
