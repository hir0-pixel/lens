# =============================================================================
# Lens — Backend-for-Frontend (BFF) environment configuration
# =============================================================================
# Copy this file to `.env` and fill in values. NEVER commit real secrets.
# The BFF is a same-origin reverse-proxy boundary that holds the OIDC client
# secret. The browser UI never sees access/refresh tokens.
#
# See server/docs/AUTHENTICATION.md for local dev, test gateway, and
# production configuration guides.

# --- Runtime ----------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Port the BFF listens on (dev default). Production reverse proxies typically
# serve this on the app origin itself.
PORT=3001
# Approved origin of the Lens web app. Must be HTTPS in production.
APP_ORIGIN=http://localhost:1420

# --- Session cookies --------------------------------------------------------
# Required. Generate with: openssl rand -base64 48  (at least 32 bytes)
SESSION_SECRET=change-me-generate-a-long-random-secret

# --- OIDC (corporate Identity Gateway) --------------------------------------
# These values are provided by your identity/infrastructure team. Do not
# invent or hard-code them.
#
# Base issuer URL of the company Identity Gateway (Keycloak realm, EntraID
# tenant, etc). The BFF appends /.well-known/openid-configuration.
#OIDC_ISSUER=https://identity.example.com/realms/lens
# Confidential (web) OIDC client registered for the Lens BFF.
#OIDC_CLIENT_ID=lens-bff
#OIDC_CLIENT_SECRET=
# Must exactly match a registered redirect URI. Same-origin callback.
#OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
#OIDC_SCOPES=openid profile email

# --- Test gateway mode (isolated, explicit opt-in) --------------------------
# Enabling test mode makes the app behave as the legacy LAN test gateway.
# Production builds REFUSE to start when this is true.
#OIDC_TEST_MODE=true
# Allowed CORS origins (comma-separated). Defaults to APP_ORIGIN.
#OIDC_ALLOWED_ORIGINS=http://localhost:1420

# --- Rate limiting ----------------------------------------------------------
#RATE_LIMIT_WINDOW_MS=900000
#RATE_LIMIT_MAX_REQUESTS=100
#AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- Dummy-data Enterprise RAG bridge ----------------------------------------
# Development only. The desktop app calls the BFF; the BFF calls only a
# loopback RAG service. The Gemini key belongs in Enterprise-RAG/.env and must
# never be placed in a VITE_ variable or sent to the browser.
#RAG_PROVIDER_MODE=gemini-test
#RAG_SERVICE_URL=http://127.0.0.1:8010
#RAG_SERVICE_TOKEN=generate-a-random-32-character-minimum-token

# --- Logging ----------------------------------------------------------------
#LOG_LEVEL=info
